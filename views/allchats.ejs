<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>All Chats</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet">
</head>

<body>

<div class="container mt-5">

    <h1 class="mb-4">All Chats</h1>

    <table class="table table-bordered table-striped">

        <thead class="table-dark">
            <tr>
                <th>To</th>
                <th>From</th>
                <th>Message</th>
                <th>Created At</th>
            </tr>
        </thead>

        <tbody>

            <% chats.forEach(chat => { %>

                <tr>
                    <td><%= chat.to %></td>
                    <td><%= chat.from %></td>
                    <td><%= chat.msg %></td>
                    <td><%= chat.created_at.toLocaleString() %></td>
                </tr>

            <% }) %>

        </tbody>

    </table>

   

</div>

</body>
</html>

